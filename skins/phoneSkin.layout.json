{
// Phone skin. Loaded on Android instead of the size driven default/compact pair, because
// neither of those is designed for a touch screen: the view here is roughly 845x400
// logical pixels, which the room scene scales down to about 0.73, so every measurement
// below is worth 0.73 logical pixels on the device and the values are chosen to land on
// finger sized targets. The file is a superset of compactSkinAlt.layout.json: keys the
// phone skin does not mention fall through to defaultSkinAlt.layout.json.
"common":
{
    "chooseGeneralBoxSwitchIconSizeThreshold": 10,
    "chooseGeneralBoxSwitchIconEachRow": 5,
    "chooseGeneralBoxSwitchIconEachRowForTooManyGenerals": 6,
    "chooseGeneralBoxNoIconThreshold": 24,
    // These two are in logical pixels, not scene units: they are handed straight to
    // QAbstractButton::setIconSize by ChooseGeneralDialog, which is an unscaled dialog.
    // Five columns of 124 plus the lord's card fit inside the 845 pixel wide screen.
    "chooseGeneralBoxSparseIconSize": [124, 174],
    "chooseGeneralBoxDenseIconSize": [96, 96],

    "cardFootnoteFont": ["DroidSansFallback", [18, 18, 3], 0, [255, 255, 255, 255], 1, 10, [0, 0], [20, 20, 20, 255]],
    "graphicsBoxTitleFont": ["DroidSansFallback", 22, 2, [228, 213, 160]],
    "optionButtonText": ["DroidSansFallback", [23, 23, 0], 0, [255, 255, 255, 255], 1, 10, [0, 0], [50, 50, 50, 200]],
    "magatamaFont": [
        ["DroidSansFallback", [21, 21, -2], 80, [233, 0, 0, 255], 2, 10, [0, 0], [20, 20, 20, 155]],
        ["DroidSansFallback", [21, 21, -2], 80, [233, 34, 34, 255], 2, 10, [0, 0], [20, 20, 20, 155]],
        ["DroidSansFallback", [21, 21, -2], 80, [233, 116, 34, 255], 2, 10, [0, 0], [20, 20, 20, 155]],
        ["DroidSansFallback", [21, 21, -2], 80, [195, 195, 34, 255], 2, 10, [0, 0], [20, 20, 20, 155]],
        ["DroidSansFallback", [21, 21, -2], 80, [141, 195, 34, 255], 2, 10, [0, 0], [20, 20, 20, 155]],
        ["DroidSansFallback", [21, 21, -2], 80, [66, 174, 34, 255], 2, 10, [0, 0], [20, 20, 20, 155]]
    ]
},
"room":
