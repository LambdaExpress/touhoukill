    // and seat, and at the compact skin's 60 it was too small to read at a glance.
    "roleBoxHeight": 78,
    "chatTextBoxHeight": 60,
    "logBoxHeightPercentage": 0.6,
    "chatBoxHeightPercentage": 0.4,
    "infoPlaneWidthPercentage": 0.19,
    "photoRoomPadding": 10,
    "photoHDistance": 24,
    "photoVDistance": 12,
    "discardPileMinWidth": 400,
